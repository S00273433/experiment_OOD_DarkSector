<Window x:Class="EscapeDS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EscapeDS"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">

    <TabControl>
        <TabItem Header="Story">
            <Grid Background="LightBlue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="33*"/>
                    <ColumnDefinition Width="33*"/>
                    <ColumnDefinition Width="33*"/>
                </Grid.ColumnDefinitions>
                
                <Label x:Name="LBLPlayerHealth" Content=" Player Health" FontSize="24" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="10" TextWrapping="WrapWithOverflow" Name="txtPlayerHealth"
               Text="12" Height="101"/>
                
                
                
                <Label x:Name="LBLEnemyHealth" Content=" Enemy Health" FontSize="24" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="10" TextWrapping="WrapWithOverflow" Name="txtEnemyHealth" Text="txt" Height="101" />
                

                <Image x:Name="imgCard" Grid.Row="0" Grid.Column="1" Margin="10" Source="/CardImage/1.jpg"/>

                <TextBlock Grid.Row="1" Grid.Column="1" Margin="10" TextWrapping="WrapWithOverflow" Name="txtStory"
                               Text="txt"/>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="10" Grid.RowSpan="2">
                    <Label Content="Action buttons" FontSize="24" HorizontalAlignment="Center"/>
                    <Button x:Name="btnCombat" Content="Combat" Margin="10" Click="btnCombat_Click"/>
                    <Button x:Name="btnDiceRoll" Content="Dice Roll" Margin="10"/>
                    <Button x:Name="btnOther" Content="Next Card" Margin="10" Click="btnOther_Click"/>
                </StackPanel>


                <Grid Grid.Row="1" Grid.Column="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnFlank" Content="Flank" Grid.Row="0" Grid.Column="0" Margin="5"/>
                    <Button x:Name="btnHeal" Content="Heal" Grid.Row="0" Grid.Column="1" Margin="5"/>
                    <Button x:Name="btnLoot" Content="Reload" Grid.Row="0" Grid.Column="2" Margin="5"/>

                    <Button x:Name="btnCard1" Content="Laspistol" Grid.Row="1" Grid.Column="0" Margin="5" Visibility="Visible"/>
                    <Button x:Name="btnCard2" Content="Battle Rifle" Grid.Row="1" Grid.Column="1" Margin="5" Visibility="Visible"/>
                    <Button x:Name="btnCard3" Content="Reload" Grid.Row="1" Grid.Column="2" Margin="5" Visibility="Visible"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" TextWrapping="WrapWithOverflow" Grid.ColumnSpan="3" Text="Flank: Attempt to outmaneuver your enemy, increasing your chances of landing a successful attack."/>

                </Grid>

            </Grid>
        </TabItem>

        <TabItem Header="Crew">
            <Grid Background="LightBlue">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="21*"/>
                    <ColumnDefinition Width="773*"/>
                </Grid.ColumnDefinitions>

                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" Margin="257,10,0,0" Grid.Column="1"><Run Language="en-ie" Text="Escape the dark sector"/></TextBlock>
                <Image x:Name="CrewPic1" HorizontalAlignment="Left" Height="197" Margin="257,42,0,0" VerticalAlignment="Top" Width="112" OpacityMask="Red"  Grid.Column="1"/>
                <Image x:Name="CrewPic1_Copy" HorizontalAlignment="Left" Height="197" Margin="376,42,0,0" VerticalAlignment="Top" Width="112" OpacityMask="Red"  Grid.Column="1"/>
                <Label Content="Crew 1" HorizontalAlignment="Left" Height="27" Margin="285,237,0,0" VerticalAlignment="Top" Width="56" Grid.Column="1"/>
                <Label Content="Crew 2" HorizontalAlignment="Left" Height="27" Margin="404,237,0,0" VerticalAlignment="Top" Width="56" Grid.Column="1"/>
                <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="190" Margin="493,42,0,0" VerticalAlignment="Top" Width="194" Grid.Column="1"/>
                <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="190" Margin="58,42,0,0" VerticalAlignment="Top" Width="194" Grid.Column="1"/>
                <Label Content="Inventory" HorizontalAlignment="Left" Height="27" Margin="541,237,0,0" VerticalAlignment="Top" Width="88" Grid.Column="1"/>
                <Label Content="Inventory" HorizontalAlignment="Left" Height="27" Margin="111,237,0,0" VerticalAlignment="Top" Width="88" Grid.Column="1"/>
                <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="73" Margin="58,269,0,0" VerticalAlignment="Top" Width="193" Grid.Column="1"/>
                <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="67" Margin="495,275,0,0" VerticalAlignment="Top" Width="192" Grid.Column="1"/>

            </Grid>
        </TabItem>
    </TabControl>

</Window>
