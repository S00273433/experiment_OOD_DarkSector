<Window x:Class="EscapeDS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EscapeDS"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
        
    <TabControl>
            <TabItem Header="Story">
                <Grid Background="LightBlue">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="50*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="33*"/>
                        <ColumnDefinition Width="33*"/>
                        <ColumnDefinition Width="33*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content=" Player Health" FontSize="24" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="0"/>

                    <Label Content=" Enemy Health" FontSize="24" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="0"/>


                    <Image x:Name="imgCard" Grid.Row="0" Grid.Column="1" Margin="10" Source="/CardImage/1.jpg"/>

                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="10" TextWrapping="WrapWithOverflow"  Text="You are a survivor in a post-apocalyptic world, struggling to survive against the odds. The world has been ravaged by a mysterious event, leaving it in ruins and overrun by dangerous creatures. You must navigate through the desolate landscape, scavenge for resources, and fight off threats to stay alive. Your ultimate goal is to find a safe haven where you can rebuild your life and find hope amidst the darkness."/>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="10" Grid.RowSpan="2">
                        <Label Content="Action buttons" FontSize="24" HorizontalAlignment="Left"/>
                        <Button x:Name="btnCombat" Content="Combat" Margin="10"/>
                        <Button x:Name="btnDiceRoll" Content="Dice Roll" Margin="10"/>
                        <Button x:Name="btnOther" Content="Other" Margin="10"/>
                    </StackPanel>


                    <Grid Grid.Row="1" Grid.Column="2" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnFlank" Content="Combat" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <Button x:Name="btnHeal" Content="Heal" Grid.Row="0" Grid.Column="1" Margin="5"/>
                        <Button x:Name="btnLoot" Content="Reload" Grid.Row="0" Grid.Column="2" Margin="5"/>

                        <Button x:Name="btnCard1" Content="Card 1" Grid.Row="1" Grid.Column="0" Margin="5" Visibility="Hidden"/>
                        <Button x:Name="btnCard2" Content="Card 2" Grid.Row="1" Grid.Column="1" Margin="5" Visibility="Hidden"/>
                        <Button x:Name="btnCard3" Content="Card 3" Grid.Row="1" Grid.Column="2" Margin="5" Visibility="Hidden"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="5" TextWrapping="WrapWithOverflow" Grid.ColumnSpan="3" Text="Flank: Attempt to outmaneuver your enemy, increasing your chances of landing a successful attack."/>

                    </Grid>
                    <!--<Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" Height="320" Margin="124,10,0,0" VerticalAlignment="Top" Width="248">
                        <Image HorizontalAlignment="Center" Height="300" VerticalAlignment="Top" Width="234" Source="/Screenshot 2026-02-25 095010.png" Margin="0,-1,0,0"/>
                        
                    </Border>
                    <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" Height="320" Margin="395,10,0,0" VerticalAlignment="Top" Width="215"/>
                    <Label Grid.Column="1" Content="unturned&#xD;&#xA;deck" HorizontalAlignment="Left" Height="44" Margin="469,29,0,0" VerticalAlignment="Top" Width="66" RenderTransformOrigin="1.031,0.57"/>
                    <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="106" Margin="0,45,0,0" VerticalAlignment="Top" Width="76" Grid.Column="1">
                        <Label Content="Flank" HorizontalAlignment="Center" Height="32" Margin="0,9,0,0" VerticalAlignment="Top" Width="56"/>
                    </Border>
                    <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="106" Margin="0,203,0,0" VerticalAlignment="Top" Width="76" Grid.Column="1">
                        <Label Content="Medical &#xD;&#xA;Drone" HorizontalAlignment="Center" Height="43" Margin="0,9,0,0" VerticalAlignment="Top" Width="56"/>
                    </Border>
                    <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Left" Height="104" Margin="623,12,0,0" VerticalAlignment="Top" Width="108">
                        <Label Content="Loot" HorizontalAlignment="Left" Height="30" Margin="9,9,0,0" VerticalAlignment="Top" Width="58"/>
                    </Border>-->
                </Grid>
            </TabItem>

            <TabItem Header="Crew">
                <Grid Background="LightBlue">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21*"/>
                        <ColumnDefinition Width="773*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" Margin="257,10,0,0" Grid.Column="1"><Run Language="en-ie" Text="Escape the dark sector"/></TextBlock>
                    <Image x:Name="CrewPic1" HorizontalAlignment="Left" Height="197" Margin="257,42,0,0" VerticalAlignment="Top" Width="112" OpacityMask="Red" Source="/20251006_233842656_iOS.jpg" Grid.Column="1"/>
                    <Image x:Name="CrewPic1_Copy" HorizontalAlignment="Left" Height="197" Margin="376,42,0,0" VerticalAlignment="Top" Width="112" OpacityMask="Red" Source="/20251006_233842656_iOS.jpg" Grid.Column="1"/>
                    <Label Content="Crew 1" HorizontalAlignment="Left" Height="27" Margin="285,237,0,0" VerticalAlignment="Top" Width="56" Grid.Column="1"/>
                    <Label Content="Crew 2" HorizontalAlignment="Left" Height="27" Margin="404,237,0,0" VerticalAlignment="Top" Width="56" Grid.Column="1"/>
                    <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="190" Margin="493,42,0,0" VerticalAlignment="Top" Width="194" Grid.Column="1"/>
                    <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="190" Margin="58,42,0,0" VerticalAlignment="Top" Width="194" Grid.Column="1"/>
                    <Label Content="Inventory" HorizontalAlignment="Left" Height="27" Margin="541,237,0,0" VerticalAlignment="Top" Width="88" Grid.Column="1"/>
                    <Label Content="Inventory" HorizontalAlignment="Left" Height="27" Margin="111,237,0,0" VerticalAlignment="Top" Width="88" Grid.Column="1"/>
                    <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="73" Margin="58,269,0,0" VerticalAlignment="Top" Width="193" Grid.Column="1"/>
                    <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="67" Margin="495,275,0,0" VerticalAlignment="Top" Width="192" Grid.Column="1"/>

                </Grid>
            </TabItem>
        </TabControl>

</Window>
