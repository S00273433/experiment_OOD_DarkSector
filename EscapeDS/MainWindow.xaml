<Window x:Class="EscapeDS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EscapeDS"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">

    <TabControl>
        <TabItem Header="Story">
            <Grid Background="LightBlue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50*"/>
                    <RowDefinition Height="50*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="33*"/>
                    <ColumnDefinition Width="33*"/>
                    <ColumnDefinition Width="33*"/>
                </Grid.ColumnDefinitions>
                
                <Label x:Name="LBLPlayerHealth" Content=" Player Health" FontSize="24" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0" FontFamily="Cascadia Code"/>
                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="10" TextWrapping="WrapWithOverflow" Name="txtPlayerHealth"
               Text="12" Height="101" FontSize="24" HorizontalAlignment="Center" FontFamily="Cascadia Code"/>
                
                
                
                <Label x:Name="LBLEnemyHealth" Content=" Enemy Health" FontSize="24" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Center" FontFamily="Cascadia Code"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="10" TextWrapping="WrapWithOverflow" Name="txtEnemyHealth" Text="txt" Height="101" HorizontalAlignment="Center" FontSize="20" FontFamily="Cascadia Code" />
                

                <Image x:Name="imgCard" Grid.Row="0" Grid.Column="1" Margin="10" Source="/CardImage/start.jpg"/>

                <TextBlock Grid.Row="1" Grid.Column="1" Margin="10" TextWrapping="WrapWithOverflow" Name="txtStory"
                               Text="txt" FontFamily="Cascadia Code"/>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="10" Grid.RowSpan="2">
                    <Label Content="Action buttons" FontSize="24" HorizontalAlignment="Center" FontFamily="Cascadia Code"/>
                    <Button x:Name="btnCombat" Content="Combat" Margin="10" Click="btnCombat_Click" FontFamily="Cascadia Code"/>
                    <Button x:Name="btnOther" Content="Next Card" Margin="10" Click="btnOther_Click" FontFamily="Cascadia Code"/>
                </StackPanel>


                <Grid Grid.Row="1" Grid.Column="2" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <ScrollViewer x:Name="scrollCombatInfo" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="5" Background="White">
                        <TextBlock x:Name="txtCombatInfo" TextWrapping="WrapWithOverflow" Foreground="Black"/>
                    </ScrollViewer>

                    <Button x:Name="btnHeal" Content="Heal" Grid.Row="1" Grid.Column="0" Margin="5" Click="btnHeal_Click" FontFamily="Cascadia Code"/>
                    <Button x:Name="btnPistol" Content="Laspistol" Grid.Row="2" Grid.Column="0" Margin="5" Visibility="Hidden" Click="btnPistol_Click" FontFamily="Cascadia Code"/>
                    <Button x:Name="btnRifle" Content="Battle Rifle" Grid.Row="2" Grid.Column="1" Margin="5" Visibility="Hidden" Click="btnRifle_Click" FontFamily="Cascadia Code"/>
                    <Button x:Name="btnReload" Content="Reload All" Grid.Row="2" Grid.Column="2" Margin="5" Visibility="Hidden" Click="btnReload_Click" FontFamily="Cascadia Code"/>
                </Grid>

            </Grid>
        </TabItem>

        
    </TabControl>

</Window>
